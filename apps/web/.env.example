# Copy to .env.local and fill in. .env.local is gitignored.

# Privy — create an app at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=''
PRIVY_APP_SECRET=''

# The relayer pays every network fee, which is what lets an employee hold equity on
# an unactivated Hedera account and never touch HBAR. It only triggers releaseVested,
# which is permissionless on-chain anyway — so a compromised relayer wastes gas but
# cannot move anyone's equity. Use a funded testnet key that is NOT your issuer admin.
RELAYER_PRIVATE_KEY=''

NEXT_PUBLIC_RPC_URL='https://testnet.hashio.io/api'

# ---------------------------------------------------------------------------
# Payroll — only needed if you run payroll from this app.
# ---------------------------------------------------------------------------
# Officer keys for the Privy key quorum. setup-payroll-org.mjs writes them to
# .env.payroll.local for local use; on a host, set them here instead. Paste either the
# whole PEM on one line with \n for newlines, or just the base64 body — both work.
PAYROLL_OFFICER_1_KEY=''
PAYROLL_OFFICER_2_KEY=''

# Signs payroll session cookies. Optional: derived from PRIVY_APP_SECRET when unset. Set
# it if you want to rotate one secret without signing everyone out of the other.
PAYROLL_SESSION_SECRET=''

# Optional. The domain the payroll sign-in message must name. Defaults to the request's
# Host header; pin it here if your host's proxy rewrites Host.
PAYROLL_SIGNIN_DOMAIN=''
