# Copy to .env.local and fill in. .env.local is gitignored.

# Privy — create an app at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=''
PRIVY_APP_SECRET=''

# The relayer pays every network fee, which is what lets an employee hold equity on
# an unactivated Hedera account and never touch HBAR. It only triggers releaseVested,
# which is permissionless on-chain anyway — so a compromised relayer wastes gas but
# cannot move anyone's equity. Use a funded testnet key that is NOT your issuer admin.
RELAYER_PRIVATE_KEY=''

NEXT_PUBLIC_RPC_URL='https://testnet.hashio.io/api'
